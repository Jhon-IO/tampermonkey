// ==UserScript==
// @name         Limpeza de Cache por Atalho Ctrl+F5 mais robustos sem nescessidade de reiniciar o navegador
// @namespace    http://tampermonkey.net/
// @version      1.3
// @description  Limpa os dados locais e Service ao pressionar Ctrl+F5.
// @match        *://*/*
// @run-at       document-end
// ==/UserScript==

(function() {
    'use strict';

    const currentHost = window.location.hostname;

    async function executeCleanupAndReload() {
        const overlay = document.createElement('div');
        Object.assign(overlay.style, {
            position: 'fixed',
            top: '0',
            left: '0',
            width: '100vw',
            height: '100vh',
            backgroundColor: 'rgba(15, 23, 42, 0.95)',
            zIndex: '1000000',
            display: 'flex',
            flexDirection: 'column',
            justifyContent: 'center',
            alignItems: 'center',
            color: '#f8fafc',
            fontFamily: 'sans-serif',
            backdropFilter: 'blur(4px)'
        });

        overlay.innerHTML = `
            <div style="text-align: center;">
                <div style="font-size: 40px; margin-bottom: 16px; color: inherit; display: inline-flex;">
                <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46C19.54 15.03 20 13.57 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74C4.46 8.97 4 10.43 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z"/>
                </svg>
            </div>
                <h2 style="margin: 0 0 8px 0; font-size: 22px; font-weight: bold;">Atualizando e Limpando Cache...</h2>
                <p style="margin: 0; color: #94a3b8; font-size: 14px;">Removendo dados antigos e recarregando ${currentHost}</p>
            </div>
        `;
        document.body.appendChild(overlay);

        try {
            if ('caches' in window) {
                const names = await caches.keys();
                await Promise.all(names.map(name => caches.delete(name)));
            }

            localStorage.clear();
            sessionStorage.clear();

            if ('serviceWorker' in navigator) {
                const registrations = await navigator.serviceWorker.getRegistrations();
                for (let registration of registrations) {
                    await registration.unregister();
                }
            }
        } catch (error) {
            console.error('Erro ao limpar o cache:', error);
        } finally {
            window.location.reload(true);
        }
    }

    window.addEventListener('keydown', (e) => {
        if (e.ctrlKey && e.key === 'F5') {
            e.preventDefault();
            executeCleanupAndReload();
        }
    });
})();
